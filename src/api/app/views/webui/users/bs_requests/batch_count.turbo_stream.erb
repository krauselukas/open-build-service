<% @counts_grouped_by_state.each do |state, count| %>
  <%= turbo_stream.update "count_#{state}" do %>
    <span><%= count %></span>
  <% end %>
<% end %>
<% @counts_grouped_by_type.each do |type, count| %>
  <%= turbo_stream.update "count_#{type}" do %>
    <span><%= count %></span>
  <% end %>
<% end %>
